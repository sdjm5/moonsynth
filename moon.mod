name = "SDJM5/moonsynth"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/SDJM5/moonsynth"

license = "Apache-2.0"

keywords = [ "audio", "synth", "dsp", "wasm", "web" ]

preferred_target = "wasm"

description = "moonsynth: a polyphonic browser synthesizer whose entire DSP core — PolyBLEP oscillators, biquad filters, ADSR envelopes, ping-pong delay — is MoonBit compiled to WebAssembly, driven through an AudioWorklet."

warnings = "-test_unqualified_package"
